[{"id":"车_che1","hanzi":"车","pinyin":"chē","hanViet":"xa","vi":"xe","topic":"transport-travel","freqRank":120,"pos":["n","q"],"classifiers":["辆"],"chars":[{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"Giản thể của 車, tượng hình cỗ xe nhìn từ trên xuống: thùng xe, trục và hai bánh → xe.","example":{"zh":"他骑车上班。","py":"Tā qí chē shàngbān.","vi":"Anh ấy đi làm bằng xe đạp. (Bài A2 — điền 骑)"},"source":"manual"},{"id":"汽车_qi4che1","hanzi":"汽车","pinyin":"qìchē","hanViet":"khí xa","vi":"ô tô","topic":"transport-travel","freqRank":286,"pos":["n"],"classifiers":["辆"],"chars":[{"c":"汽","radical":"水","radicalVi":"thủy","strokes":7,"parts":"⿰氵气"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>汽</b> (<b>氵</b> nước + <b>气</b> hơi) + <b>车</b> (xe) → xe chạy bằng hơi/động cơ → ô tô.","example":{"zh":"我坐公共汽车去学校。","py":"Wǒ zuò gōnggòng qìchē qù xuéxiào.","vi":"Tôi đi học bằng xe buýt."},"source":"manual"},{"id":"飞机_fei1ji1","hanzi":"飞机","pinyin":"fēijī","hanViet":"phi cơ","vi":"máy bay","topic":"transport-travel","freqRank":315,"pos":["n"],"classifiers":["架"],"chars":[{"c":"飞","radical":"飞","radicalVi":"phi","strokes":3},{"c":"机","radical":"木","radicalVi":"mộc","strokes":6,"parts":"⿰木几"}],"structure":"<b>飞</b> (bay) + <b>机</b> (máy) → máy bay.","example":{"zh":"我很怕坐飞机。","py":"Wǒ hěn pà zuò fēijī.","vi":"Tôi rất sợ đi máy bay. (Bài B6 — đáp án gợi ý)"},"source":"manual"},{"id":"船_chuan2","hanzi":"船","pinyin":"chuán","hanViet":"thuyền","vi":"thuyền, tàu thủy","topic":"transport-travel","freqRank":350,"pos":["n"],"classifiers":["条","艘","只"],"chars":[{"c":"船","radical":"舟","radicalVi":"chu","strokes":11,"parts":"⿰舟⿱几口"}],"structure":"<b>舟</b> (tượng hình chiếc thuyền) + phần biểu âm → thuyền, tàu.","example":{"zh":"我们坐船去海边。","py":"Wǒmen zuò chuán qù hǎibiān.","vi":"Chúng tôi đi thuyền ra biển."},"source":"manual","aiFields":["example"]},{"id":"路上_lu4shang5","hanzi":"路上","pinyin":"lùshang","hanViet":"lộ thượng","vi":"trên đường","topic":"transport-travel","freqRank":382,"pos":["s"],"chars":[{"c":"路","radical":"足","radicalVi":"túc","strokes":13,"parts":"⿰足各"},{"c":"上","radical":"一","radicalVi":"nhất","strokes":3,"parts":"⿱⺊一"}],"structure":"<b>路</b> (lộ: 足+各-biểu âm) + <b>上</b> (trên) → trên đường.","example":{"zh":"回家的路上，我觉得很幸福。","py":"Huí jiā de lùshang, wǒ juéde hěn xìngfú.","vi":"Trên đường về nhà, mình cảm thấy rất hạnh phúc."},"source":"manual"},{"id":"骑_qi2","hanzi":"骑","pinyin":"qí","hanViet":"kỵ","vi":"cưỡi, đi (xe hai bánh)","topic":"transport-travel","freqRank":421,"pos":["v"],"chars":[{"c":"骑","radical":"马","radicalVi":"mã","strokes":11,"parts":"⿰马奇"}],"structure":"Giản thể 騎: <b>马</b> (ngựa) + <b>奇</b> (biểu âm) → ngồi lên ngựa → cưỡi; nay dùng cho xe đạp, xe máy.","example":{"zh":"他骑车上班。","py":"Tā qí chē shàngbān.","vi":"Anh ấy đi làm bằng xe đạp. (Bài A2 — điền 骑)"},"source":"manual"},{"id":"旅行_lv3xing2","hanzi":"旅行","pinyin":"lǚxíng","hanViet":"lữ hành","vi":"đi du lịch","topic":"transport-travel","freqRank":431,"pos":["v","vn"],"classifiers":["趟","次"],"chars":[{"c":"旅","radical":"方","radicalVi":"phương","strokes":10},{"c":"行","radical":"行","radicalVi":"hành","strokes":6,"parts":"⿰彳亍"}],"structure":"<b>旅</b> (lữ, đã có ở 旅游) + <b>行</b> (hành - đi) → đi xa, du hành.","example":{"zh":"我今天很高兴，因为我要去旅行。","py":"Wǒ jīntiān hěn gāoxìng, yīnwèi wǒ yào qù lǚxíng.","vi":"Hôm nay tôi rất vui vì tôi sắp đi du lịch. (Điền từ 1: 高兴)"},"source":"manual"},{"id":"旅游_lv3you2","hanzi":"旅游","pinyin":"lǚyóu","hanViet":"lữ du","vi":"du lịch","topic":"transport-travel","freqRank":441,"pos":["vn","v"],"chars":[{"c":"旅","radical":"方","radicalVi":"phương","strokes":10},{"c":"游","radical":"水","radicalVi":"thủy","strokes":12,"parts":"⿰氵斿"}],"structure":"<b>旅</b>: tượng hình lá cờ với nhiều người theo sau → đoàn người đi xa. <b>游</b>: <b>氵</b> (thủy - nước) + <b>斿</b> (du, biểu âm, cờ bay phấp phới) → đi lang thang, dạo chơi. Ghép: du lịch.","example":{"zh":"小安去旅游","py":"Xiǎo’ān qù lǚyóu","vi":"Tiểu An đi du lịch (tiêu đề bài đọc 2)"},"source":"manual"},{"id":"开车_kai1che1","hanzi":"开车","pinyin":"kāi chē","hanViet":"khai xa","vi":"lái xe","topic":"transport-travel","freqRank":448,"pos":["v","vn"],"chars":[{"c":"开","radical":"廾","radicalVi":"củng","strokes":4,"parts":"⿱一廾"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>开</b> (mở, vận hành) + <b>车</b> (xe) → lái xe.","example":{"zh":"我不开车，我走路。","py":"Wǒ bù kāi chē, wǒ zǒu lù.","vi":"Tôi không lái xe, tôi đi bộ."},"source":"manual"},{"id":"出租车_chu1zu1che1","hanzi":"出租车","pinyin":"chūzūchē","hanViet":"xuất tô xa","vi":"taxi","topic":"transport-travel","freqRank":449,"pos":["n"],"chars":[{"c":"出","radical":"凵","radicalVi":"khảm","strokes":5,"parts":"⿱屮凵"},{"c":"租","radical":"禾","radicalVi":"hòa","strokes":10,"parts":"⿰禾且"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>出租</b> (<b>出</b> ra + <b>租</b>: <b>禾</b> lúa + <b>且</b> → cho thuê) + <b>车</b> (xe) → xe cho thuê = taxi.","example":{"zh":"我每天都坐出租车。","py":"Wǒ měitiān dōu zuò chūzūchē.","vi":"Tôi mỗi ngày đều đi taxi. (Bài B5 — đáp án gợi ý)"},"source":"manual"},{"id":"火车_huo3che1","hanzi":"火车","pinyin":"huǒchē","hanViet":"hỏa xa","vi":"tàu hỏa","topic":"transport-travel","freqRank":458,"pos":["n"],"classifiers":["列","节","班","趟"],"chars":[{"c":"火","radical":"火","radicalVi":"hỏa","strokes":4,"parts":"⿻丷人"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>火</b> (lửa) + <b>车</b> (xe) → xe chạy bằng lửa, hơi nước → tàu hỏa.","example":{"zh":"我坐火车去北京。","py":"Wǒ zuò huǒchē qù Běijīng.","vi":"Tôi đi tàu hỏa đến Bắc Kinh."},"source":"manual","aiFields":["example"]},{"id":"地铁_di4tie3","hanzi":"地铁","pinyin":"dìtiě","hanViet":"địa thiết","vi":"tàu điện ngầm","topic":"transport-travel","freqRank":465,"pos":["n"],"chars":[{"c":"地","radical":"土","radicalVi":"thổ","strokes":6,"parts":"⿰土也"},{"c":"铁","radical":"金","radicalVi":"kim","strokes":10,"parts":"⿰钅失"}],"structure":"<b>地</b> (đất) + <b>铁</b> (<b>钅</b> kim loại + <b>失</b>, sắt) → đường sắt dưới đất → tàu điện ngầm.","example":{"zh":"地铁又快又方便。","py":"Dìtiě yòu kuài yòu fāngbiàn.","vi":"Cấu trúc 又…又… (vừa…vừa…): Tàu điện ngầm vừa nhanh vừa tiện."},"source":"manual"},{"id":"自行车_zi4xing2che1","hanzi":"自行车","pinyin":"zìxíngchē","hanViet":"tự hành xa","vi":"xe đạp","topic":"transport-travel","freqRank":483,"pos":["n"],"classifiers":["辆"],"chars":[{"c":"自","radical":"自","radicalVi":"tự","strokes":6},{"c":"行","radical":"行","radicalVi":"hành","strokes":6,"parts":"⿰彳亍"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>自行</b> (<b>自</b> tự mình + <b>行</b> đi) + <b>车</b> (xe) → xe tự đi bằng sức người = xe đạp.","example":{"zh":"我弟弟骑自行车去图书馆。","py":"Wǒ dìdi qí zìxíngchē qù túshūguǎn.","vi":"Em trai tôi đi xe đạp đến thư viện. (Bài A5 — điền 骑)"},"source":"manual"},{"id":"摩托车_mo2tuo1che1","hanzi":"摩托车","pinyin":"mótuōchē","hanViet":"ma thác xa","vi":"xe máy","topic":"transport-travel","freqRank":505,"pos":["n"],"classifiers":["辆","部"],"chars":[{"c":"摩","radical":"手","radicalVi":"thủ","strokes":15,"parts":"⿸麻手"},{"c":"托","radical":"手","radicalVi":"thủ","strokes":6,"parts":"⿰扌乇"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>摩托</b> (phiên âm từ \"motor\") + <b>车</b> (xe) → xe máy.","example":{"zh":"她骑摩托车上班。","py":"Tā qí mótuōchē shàngbān.","vi":"Cô ấy đi làm bằng xe máy. (Bài B2 — đáp án gợi ý)"},"source":"manual"},{"id":"走路_zou3lu4","hanzi":"走路","pinyin":"zǒulù","hanViet":"tẩu lộ","vi":"đi bộ","topic":"transport-travel","freqRank":515,"pos":["v","vn"],"chars":[{"c":"走","radical":"走","radicalVi":"tẩu","strokes":7,"parts":"⿱土止"},{"c":"路","radical":"足","radicalVi":"túc","strokes":13,"parts":"⿰足各"}],"structure":"<b>走</b> (đi bộ) + <b>路</b> (<b>足</b> chân + <b>各</b> → con đường) → đi bộ.","example":{"zh":"她走路去学校。","py":"Tā zǒu lù qù xuéxiào.","vi":"Cô ấy đi bộ đến trường. (Bài A3 — điền 走)"},"source":"manual"},{"id":"骑车_qi2che1","hanzi":"骑车","pinyin":"qí chē","hanViet":"kỵ xa","vi":"đi xe đạp/xe máy","topic":"transport-travel","freqRank":548,"pos":["v"],"chars":[{"c":"骑","radical":"马","radicalVi":"mã","strokes":11,"parts":"⿰马奇"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>骑(騎)</b>: <b>马</b> (ngựa) + <b>奇</b> (biểu âm) → cưỡi; + <b>车</b> (xe) → đi (xe hai bánh).","example":{"zh":"他骑车上班。","py":"Tā qí chē shàngbān.","vi":"Anh ấy đi làm bằng xe đạp. (Bài A2 — điền 骑)"},"source":"manual"},{"id":"海边_hai3bian1","hanzi":"海边","pinyin":"hǎibiān","hanViet":"hải biên","vi":"bờ biển","topic":"transport-travel","freqRank":549,"pos":["s"],"chars":[{"c":"海","radical":"水","radicalVi":"thủy","strokes":10,"parts":"⿰氵每"},{"c":"边","radical":"辵","radicalVi":"sước","strokes":5,"parts":"⿺辶力"}],"structure":"<b>海</b> (<b>氵</b> nước + <b>每</b> biểu âm) → biển; <b>边(邊)</b>: <b>辶</b> + phần biểu âm → bên cạnh. Ghép: bờ biển.","example":{"zh":"我们先去山上，后来去海边。","py":"Wǒmen xiān qù shānshàng, hòulái qù hǎibiān.","vi":"Chúng mình đi lên núi trước, sau đó đi ra biển."},"source":"manual"},{"id":"公共汽车_gong1gong4qi4che1","hanzi":"公共汽车","pinyin":"gōnggòng qìchē","hanViet":"công cộng khí xa","vi":"xe buýt","topic":"transport-travel","freqRank":580,"classifiers":["辆","班"],"chars":[{"c":"公","radical":"八","radicalVi":"bát","strokes":4,"parts":"⿱八厶"},{"c":"共","radical":"八","radicalVi":"bát","strokes":6,"parts":"⿳廾一八"},{"c":"汽","radical":"水","radicalVi":"thủy","strokes":7,"parts":"⿰氵气"},{"c":"车","radical":"车","radicalVi":"xa","strokes":4,"parts":"⿻七十"}],"structure":"<b>公共</b> (công cộng: 公 chung + 共 cùng nhau) + <b>汽车</b> (<b>汽</b>: <b>氵</b> nước + <b>气</b> hơi; <b>车</b> xe) → xe chạy chung cho công cộng = xe buýt.","example":{"zh":"我坐公共汽车去学校。","py":"Wǒ zuò gōnggòng qìchē qù xuéxiào.","vi":"Tôi đi học bằng xe buýt."},"source":"manual"},{"id":"高铁_gao1tie3","hanzi":"高铁","pinyin":"gāotiě","hanViet":"cao thiết","vi":"tàu cao tốc","topic":"transport-travel","freqRank":591,"chars":[{"c":"高","ra