[{"id":"不要_bu4yao4","hanzi":"不要","pinyin":"bú yào","hanViet":"bất yếu","vi":"đừng","topic":"phrases","freqRank":135,"pos":["d"],"chars":[{"c":"不","radical":"一","radicalVi":"nhất","strokes":4},{"c":"要","radical":"西","radicalVi":"tây","strokes":9,"parts":"⿱覀女"}],"structure":"<b>不</b> (không) + <b>要</b> (muốn) → đừng.","example":{"zh":"那我们不要出去吧。","py":"Nà wǒmen bú yào chūqù ba.","vi":"Vậy chúng ta đừng ra ngoài nhé."},"source":"manual"},{"id":"不用_bu4yong4","hanzi":"不用","pinyin":"bú yòng","hanViet":"bất dụng","vi":"không cần","topic":"phrases","freqRank":306,"pos":["d"],"chars":[{"c":"不","radical":"一","radicalVi":"nhất","strokes":4},{"c":"用","radical":"用","radicalVi":"dụng","strokes":5}],"structure":"<b>不</b> (không) + <b>用</b> (dùng) → không cần.","example":{"zh":"因为我休息，不用工作。","py":"Yīnwèi wǒ xiūxi, bú yòng gōngzuò.","vi":"Vì tôi được nghỉ, không phải làm việc."},"source":"manual"},{"id":"差不多_cha4bu4duo1","hanzi":"差不多","pinyin":"chàbuduō","hanViet":"sai bất đa","vi":"gần giống, xấp xỉ","topic":"phrases","freqRank":409,"pos":["l"],"chars":[{"c":"差","radical":"工","radicalVi":"công","strokes":9,"parts":"⿸羊工"},{"c":"不","radical":"一","radicalVi":"nhất","strokes":4},{"c":"多","radical":"夕","radicalVi":"tịch","strokes":6,"parts":"⿱夕夕"}],"structure":"<b>差</b> (sai - lệch) + <b>不</b> (không) + <b>多</b> (nhiều) → không sai nhiều = gần như nhau.","example":{"zh":"我们俩差不多高。","py":"Wǒmen liǎ chàbuduō gāo.","vi":"Hai chúng tôi cao xấp xỉ nhau."},"source":"manual","aiFields":["example"]},{"id":"看起来_kan4qi3lai2","hanzi":"看起来","pinyin":"kànqǐlái","hanViet":"khán khởi lai","vi":"trông có vẻ","topic":"phrases","freqRank":469,"pos":["v"],"chars":[{"c":"看","radical":"目","radicalVi":"mục","strokes":9,"parts":"⿱手目"},{"c":"起","radical":"走","radicalVi":"tẩu","strokes":10,"parts":"⿺走己"},{"c":"来","radical":"木","radicalVi":"mộc","strokes":7,"parts":"⿻未丷"}],"structure":"<b>看</b> (xem, đã có) + <b>起来</b> (khởi lai - bắt đầu) → trông như là.","example":{"zh":"这个语言看起来很难，其实很有意思。","py":"Zhège yǔyán kànqǐ