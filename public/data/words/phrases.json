> (hảo - tốt, xem ở trên) → 'không tốt'.","example":{"zh":"今天天气不好","py":"Jīntiān tiānqì bù hǎo","vi":"Hôm nay thời tiết không tốt (tiêu đề bài đọc)"},"source":"manual"},{"id":"好的_hao3de5","hanzi":"好的","pinyin":"hǎo de","hanViet":"hảo đích","vi":"được, ok","topic":"phrases","freqRank":617,"phrase":true,"chars":[{"c":"好","radical":"女","radicalVi":"nữ","strokes":6,"parts":"⿰女子"},{"c":"的","radical":"白","radicalVi":"bạch","strokes":8,"parts":"⿰白勺"}],"structure":"<b>好</b> (hảo - tốt, đã có) + <b>的</b> (trợ từ, đã có) → cách đáp lại đồng ý 'được, ok'.","example":{"zh":"好的，请稍等。","py":"Hǎo de, qǐng shāoděng.","vi":"Được ạ, vui lòng đợi một chút."},"source":"manual"},{"id":"一下_yi1xia4","hanzi":"一下","pinyin":"yīxià","hanViet":"nhất hạ","vi":"một chút, thử xem","topic":"phrases","freqRank":619,"phrase":true,"chars":[{"c":"一","radical":"一","radicalVi":"nhất","strokes":1},{"c":"下","radical":"一","radicalVi":"nhất","strokes":3,"parts":"⿱一卜"}],"structure":"<b>一</b> (một) + <b>下</b> (hạ - xuống, đã có ở 下雨) → đặt sau động từ để giảm nhẹ mức độ, ý 'thử làm một chút'.","example":{"zh":"我可以试一下吗？","py":"Wǒ kěyǐ shì yíxià ma?","vi":"Tôi có thể thử không?"},"source":"manual"},{"id":"真的吗_zhen1de5ma5","hanzi":"真的吗","pinyin":"zhēn de ma","hanViet":"chân đích ma","vi":"thật sao?","topic":"phrases","freqRank":656,"phrase":true,"chars":[{"c":"真","radical":"目","radicalVi":"mục","strokes":10,"parts":"⿱直几"},{"c":"的","radical":"白","radicalVi":"bạch","strokes":8,"parts":"⿰白勺"},{"c":"吗","radical":"口","radicalVi":"khẩu","strokes":6,"parts":"⿰口马"}],"structure":"<b>真</b> (thật) + <b>的</b> + <b>吗</b> (trợ từ hỏi) → thật sao?","example":{"zh":"真的吗？","py":"Zhēn de ma?","vi":"Thật sao?"},"source":"manual"},{"id":"稍等_shao1deng3","hanzi":"稍等","pinyin":"shāoděng","hanViet":"sảo đẳng","vi":"đợi một chút","topic":"phrases","freqRank":668,"phrase":true,"chars":[{"c":"稍","radical":"禾","radicalVi":"hòa","strokes":12,"parts":"⿰禾肖"},{"c":"等","radical":"竹","radicalVi":"trúc","strokes":12,"parts":"⿱⺮寺"}],"structure":"<b>稍</b> (<b>禾</b> + <b>肖</b>, biểu âm → một chút) + <b>等</b> (<b>竹</b> + <b>寺</b> → đợi) → đợi một chút.","example":{"zh":"好的，请稍等。","py":"Hǎo de, qǐng shāoděng.","vi":"Được ạ, vui lòng đợi một chút."},"source":"manual"},{"id":"做什么_zuo4shen2me5","hanzi":"做什么","pinyin":"zuò shénme","hanViet":"tố thập ma","vi":"làm gì","topic":"phrases","freqRank":687,"phrase":true,"chars":[{"c":"做","radical":"人","radicalVi":"nhân","strokes":11,"parts":"⿰亻故"},{"c":"什","radical":"人","radicalVi":"nhân","strokes":4,"parts":"⿰亻十"},{"c":"么","radical":"丿","radicalVi":"phiệt","strokes":3,"parts":"⿱丿厶"}],"structure":"<b>做</b> (làm) + <b>什么</b> (cái gì) → làm gì.","example":{"zh":"你喜欢做什么？","py":"Nǐ xǐhuān zuò shénme?","vi":"Bạn thích làm gì?"},"source":"manual"},{"id":"不想_bu4xiang3","hanzi":"不想","pinyin":"bù xiǎng","hanViet":"bất tưởng","vi":"không muốn","topic":"phrases","freqRank":690,"phrase":true,"chars":[{"c":"不","radical":"一","radicalVi":"nhất","strokes":4},{"c":"想","radical":"心","radicalVi":"tâm","strokes":13,"parts":"⿱相心"}],"structure":"<b>不</b> (không) + <b>想</b> (muốn, nghĩ) → không muốn.","example":{"zh":"他很累，所以不想出去。","py":"Tā hěn lèi, suǒyǐ bù xiǎng chūqù.","vi":"Anh ấy mệt nên không muốn ra ngoài. (Dịch 3 — đáp án gợi ý)"},"source":"manual"},{"id":"你怎么了_ni3zen3me5le5","hanzi":"你怎么了","pinyin":"nǐ zěnme le","hanViet":"nễ chẩm ma liễu","vi":"bạn bị làm sao vậy?","topic":"phrases","freqRank":692,"phrase":true,"chars":[{"c":"你","radical":"人","radicalVi":"nhân","strokes":7,"parts":"⿰亻尔"},{"c":"怎","radical":"心","radicalVi":"tâm","strokes":9,"parts":"⿱乍心"},{"c":"么","radical":"丿","radicalVi":"phiệt","strokes":3,"parts":"⿱丿厶"},{"c":"了","radical":"亅","radicalVi":"quyết","strokes":2,"parts":"⿱乛亅"}],"structure":"<b>你</b> + <b>怎么</b> (thế nào) + <b>了</b> → hỏi thăm \"bạn sao thế?\".","example":{"zh":"你怎么了？","py":"Nǐ zěnme le?","vi":"Bạn bị làm sao?"},"source":"manual"},{"id":"还没有_hai2mei2you3","hanzi":"还没有","pinyin":"hái méiyǒu","hanViet":"hoàn một hữu","vi":"vẫn chưa","topic":"phrases","freqRank":694,"phrase":true,"chars":[{"c":"还","radical":"辵","radicalVi":"sước","strokes":7,"parts":"⿺辶不"},{"c":"没","radical":"水","radicalVi":"thủy","strokes":7,"parts":"⿰氵殳"},{"c":"有","radical":"月","radicalVi":"nguyệt","strokes":6}],"structure":"<b>还</b> (vẫn) + <b>没有</b> (chưa, không có) → vẫn chưa.","example":{"zh":"还没有。","py":"Hái méiyǒu.","vi":"Chưa."},"source":"manual"},{"id":"多大_duo1da4","hanzi":"多大","pinyin":"duō dà","hanViet":"đa đại","vi":"bao lớn (hỏi cỡ, tuổi)","topic":"phrases","freqRank":714,"phrase":true,"chars":[{"c":"多","radical":"夕","radicalVi":"tịch","strokes":6,"parts":"⿱夕夕"},{"c":"大","radical":"大","radicalVi":"đại","strokes":3,"parts":"⿻一人"}],"structure":"<b>多</b> (nhiều) + <b>大</b> (to) → lớn cỡ nào?","example":{"zh":"你弟弟多大？","py":"Nǐ dìdi duō dà?","vi":"Em trai bạn bao nhiêu tuổi?"},"source":"manual"}]
