[{"id":"家_jia1","hanzi":"家","pinyin":"jiā","hanViet":"gia","vi":"nhà","topic":"home","freqRank":89,"pos":["n","q"],"chars":[{"c":"家","radical":"宀","radicalVi":"miên","strokes":10,"parts":"⿱宀豕"}],"structure":"Bộ <b>宀</b> (miên - mái nhà) trên <b>豕</b> (thỉ - con heo): xưa nuôi heo dưới mái nhà là hình ảnh của một hộ gia đình → nhà, gia đình.","example":{"zh":"我家在二楼。","py":"Wǒ jiā zài èr lóu.","vi":"Nhà tôi ở tầng 2."},"source":"manual"},{"id":"住_zhu4","hanzi":"住","pinyin":"zhù","hanViet":"trú","vi":"ở, sống","topic":"home","freqRank":157,"pos":["v"],"chars":[{"c":"住","radical":"亻","strokes":7,"parts":"⿰亻主"}],"structure":"<b>亻</b> (nhân - người) + <b>主</b> (chủ, biểu âm) → người ở lại một chỗ → ở, sống.","example":{"zh":"我住在岘港，我是电气工程师。","py":"Wǒ zhù zài Xiàn Gǎng, wǒ shì diànqì gōngchéngshī.","vi":"Mình sống ở Đà Nẵng, mình là kĩ sư điện."},"source":"manual"},{"id":"楼_lou2","hanzi":"楼","pinyin":"lóu","hanViet":"lâu","vi":"tầng, lầu","topic":"home","freqRank":258,"pos":["n"],"classifiers":["层","座","栋"],"chars":[{"c":"楼","radical":"木","radicalVi":"mộc","strokes":13,"parts":"⿰木娄"}],"structure":"Giản thể của 樓: <b>木</b> (mộc - gỗ) + <b>娄</b> (lâu, biểu âm) → công trình gỗ nhiều tầng → tầng, lầu.","example":{"zh":"我家在二楼。","py":"Wǒ jiā zài èr lóu.","vi":"Nhà tôi ở tầng 2."},"source":"manual"},{"id":"床_chuang2","hanzi":"床","pinyin":"chuáng","hanViet":"sàng","vi":"giường","topic":"home","freqRank":298,"pos":["n","q"],"classifiers":["张"],"chars":[{"c":"床","radical":"广","radicalVi":"nghiễm","strokes":7,"parts":"⿸广木"}],"structure":"<b>广</b> (mái nhà) + <b>木</b> (gỗ) → đồ bằng gỗ đặt trong nhà → giường.","example":{"zh":"他每天几点起床？","py":"Tā měitiān jǐ diǎn qǐchuáng?","vi":"Anh ấy mỗi ngày mấy giờ dậy?"},"source":"manual"},{"id":"房子_fang2zi5","hanzi":"房子","pinyin":"fángzi","hanViet":"phòng tử","vi":"nhà, căn nhà","topic":"home","freqRank":311,"pos":["n"],"classifiers":["栋","幢","座","套","间"],"chars":[{"c":"房","radical":"户","radicalVi":"hộ","strokes":8,"parts":"⿸户方"},{"c":"子","radical":"子","radicalVi":"tử","strokes":3,"parts":"⿻了一"}],"structure":"<b>房</b> (phòng, đã có) + <b>子</b> (hậu tố danh từ) → căn nhà.","example":{"zh":"房子 · 压力 · 必要","py":"fángzi · yālì · bìyào","vi":"nhà, căn nhà, áp lực, cần thiết"},"source":"manual"},{"id":"房间_fang2jian1","hanzi":"房间","pinyin":"fángjiān","hanViet":"phòng gian","vi":"phòng","topic":"home","freqRank":352,"pos":["n"],"classifiers":["间","个"],"chars":[{"c":"房","radical":"户","radicalVi":"hộ","strokes":8,"parts":"⿸户方"},{"c":"间","radical":"门","radicalVi":"môn","strokes":7,"parts":"⿵门日"}],"structure":"<b>房</b>: <b>户</b> (hộ - cửa một cánh) + <b>方</b> (phương, biểu âm) → căn phòng có cửa. <b>间</b> (gian, đã có ở 时间): ánh sáng lọt qua khe cửa → khoảng không gian, phòng.","example":{"zh":"这是我们的房间。","py":"Zhè shì wǒmen de fángjiān.","vi":"Đây là phòng của chúng tôi."},"source":"manual"},{"id":"厨房_chu2fang2","hanzi":"厨房","pinyin":"chúfáng","hanViet":"trù phòng","vi":"nhà bếp","topic":"home","freqRank":468,"pos":["n"],"classifiers":["间"],"chars":[{"c":"厨","radical":"厂","radicalVi":"hán","strokes":12,"parts":"⿸厂⿰豆寸"},{"c":"房","radical":"户","radicalVi":"hộ","strokes":8,"parts":"⿸户方"}],"structure":"<b>厨(廚)</b> (<b>厂</b> mái che + <b>豆</b> + <b>寸</b> → nơi nấu nướng) + <b>房</b> (<b>户</b> cửa + <b>方</b> biểu âm → căn phòng) → nhà bếp.","example":{"zh":"厨房 · 沙发 · 下面 · 眼镜","py":"chúfáng · shāfā · xiàmiàn · yǎnjìng","vi":"Nhóm 4 – Nhà cửa và đồ dùng: nhà bếp, sofa, phía dưới, kính mắt"},"source":"manual"},{"id":"桌子_zhuo1zi5","hanzi":"桌子","pinyin":"zhuōzi","hanViet":"trác tử","vi":"bàn","topic":"home","freqRank":493,"pos":["n"],"classifiers":["张","套"],"chars":[{"c":"桌","radical":"木","radicalVi":"mộc","strokes":10,"parts":"⿱卓木"},{"c":"子","radical":"子","radicalVi":"tử","strokes":3,"parts":"⿻了一"}],"structure":"<b>桌</b>: <b>卓</b> (cao, biểu âm) + <b>木</b> (gỗ) → vật bằng gỗ cao → bàn; <b>子</b> là hậu tố danh từ.","example":{"zh":"这是桌子。","py":"Zhè shì zhuōzi.","vi":"Đây là cái bàn. (Dịch 1 — đáp án gợi ý)"},"source":"manual"},{"id":"沙发_sha1fa1","hanzi":"沙发","pinyin":"shāfā","hanViet":"sa phát","vi":"ghế sofa","topic":"home","freqRank":498,"pos":["n"],"classifiers":["条","张"],"chars":[{"c":"沙","radical":"水","radicalVi":"thủy","strokes":7,"parts":"⿰氵少"},{"c":"发","radical":"又","radicalVi":"hựu","strokes":5}],"structure":"Từ mượn phiên âm \"sofa\": <b>沙</b> (<b>氵</b> + <b>少</b> → cát) + <b>发(發)</b> (phát) → sofa.","example":{"zh":"厨房 · 沙发 · 下面 · 眼镜","py":"chúfáng · shāfā · xiàmiàn · yǎnjìng","vi":"Nhóm 4 – Nhà cửa và đồ dùng: nhà bếp, sofa, phía dưới, kính mắt"},"source":"manual"},{"id":"窗户_chuang1hu5","hanzi":"窗户","pinyin":"chuānghu","hanViet":"song hộ","vi":"cửa sổ","topic":"home","freqRank":506,"pos":["n"],"classifiers":["个","扇"],"chars":[{"c":"窗","radical":"穴","radicalVi":"huyệt","strokes":12,"parts":"⿱穴囱"},{"c":"户","radical":"户","radicalVi":"hộ","strokes":4,"parts":"⿱丶尸"}],"structure":"<b>窗</b>: <b>穴</b> (lỗ) + <b>囱</b> (ống thoát) → ô cửa; <b>户</b> (cửa một cánh) → cửa sổ.","example":{"zh":"刮风 → 关窗户","py":"Guāfēng → guān chuānghu","vi":"Gió → đóng cửa sổ"},"source":"manual"},{"id":"椅子_yi3zi5","hanzi":"椅子","pinyin":"yǐzi","hanViet":"ỷ tử","vi":"ghế","topic":"home","freqRank":513,"pos":["n"],"classifiers":["把","套"],"chars":[{"c":"椅","radical":"木","radicalVi":"mộc","strokes":12,"parts":"⿰木奇"},{"c":"子","radical":"子","radicalVi":"tử","strokes":3,"parts":"⿻了一"}],"structure":"<b>椅</b>: <b>木</b> (gỗ) + <b>奇</b> (biểu âm) → đồ gỗ để ngồi → ghế; <b>子</b> là hậu tố.","example":{"zh":"桌子旁边有椅子。","py":"Zhuōzi pángbiān yǒu yǐzi.","vi":"Bên cạnh bàn có ghế."},"source":"manual"},{"id":"卫生间_wei4sheng1jian1","hanzi":"卫生间","pinyin":"wèishēngjiān","hanViet":"vệ sinh gian","vi":"phòng vệ sinh, nhà vệ sinh","topic":"home","freqRank":550,"pos":["n"],"classifiers":["间"],"chars":[{"c":"卫","radical":"乛","radicalVi":"chiết","strokes":3,"parts":"⿱乛一"},{"c":"生","radical":"生","radicalVi":"sinh","strokes":5,"parts":"⿻一土"},{"c":"间","radical":"门","radicalVi":"môn","strokes":7,"parts":"⿵门日"}],"structure":"<b>卫(衛)</b> (bảo vệ) + <b>生</b> (sống, sinh hoạt) + <b>间(間)</b> (<b>门</b> + <b>日</b> → khoảng giữa, căn phòng) → phòng vệ sinh.","example":{"zh":"卫生间在哪里？","py":"Wèishēngjiān zài nǎlǐ?","vi":"Nhà vệ sinh ở đâu?"},"source":"manual","aiFields":["example"]},{"id":"窗帘_chuang1lian2","hanzi":"窗帘","pinyin":"chuānglián","hanViet":"song liêm","vi":"rèm cửa sổ","topic":"home","freqRank":565,"pos":["n"],"chars":[{"c":"窗","radical":"穴","radicalVi":"huyệt","strokes":12,"parts":"⿱穴囱"},{"c":"帘","radical":"巾","radicalVi":"cân","strokes":8,"parts":"⿱穴巾"}],"structure":"<b>窗</b> (<b>穴</b> hang, lỗ + phần biểu âm → ô cửa trên tường) + <b>帘</b> (tấm che, có bộ <b>巾</b> khăn, vải) → tấm che cửa sổ = rèm cửa.","example":{"zh":"窗帘是蓝色的。","py":"Chuānglián shì lánsè de.","vi":"Rèm cửa màu xanh dương."},"source":"manual","aiFields":["example"]},{"id":"水龙头_shui3long2tou2","hanzi":"水龙头","pinyin":"shuǐlóngtóu","hanViet":"thủy long đầu","vi":"vòi nước","topic":"home","freqRank":586,"pos":["n"],"chars":[{"c":"水","radical":"水","radicalVi":"thủy","strokes":4},{"c":"龙","radical":"龙","radicalVi":"long","strokes":5,"parts":"⿻尤丿"},{"c":"头","radical":"大","radicalVi":"đại","strokes":5,"parts":"⿻⺀大"}],"structure":"<b>水</b> (nước) + <b>龙(龍)</b> (rồng) + <b>头</b> (đầu) → đầu rồng phun nước = vòi nước.","example":{"zh":"水龙头坏了。","py":"Shuǐlóngtóu huài le.","vi":"Vòi nước hỏng rồi."},"source":"manual","aiFields":["example"]},{"id":"水壶_shui3hu2","hanzi":"水壶","pinyin":"shuǐhú","hanViet":"thủy hồ","vi":"bình nước","topic":"home","freqRank":587,"pos":["n"],"chars":[{"c":"水","radical":"水","radicalVi":"thủy","strokes":4},{"c":"壶","radical":"士","radicalVi":"sĩ","strokes":10,"parts":"⿱士⿱冖业"}],"structure":"<b>水</b> (nước) + <b>壶</b> (hình cái bình có nắp và quai) → bình nước.","example":{"zh":"水壶里没有水了。","py":"Shuǐhú li méiyǒu shuǐ le.","vi":"Trong bình hết nước rồi."},"source":"manual","aiFields":["example"]},{"id":"刀子_dao1zi5","hanzi":"刀子","pinyin":"dāozi","hanViet":"đao tử","vi":"dao","topic":"home","freqRank":660,"phrase":true,"chars":[{"c":"刀","radical":"刀","radicalVi":"đao","strokes":2},{"c":"子","radical":"子","radicalVi":"tử","strokes":3,"parts":"⿻了一"}],"structure":"<b>刀</b> tượng hình lưỡi dao; <b>子</b> là hậu tố → con dao.","example":{"zh":"筷子 · 勺子 · 杯子 · 叉子 · 刀子","py":"kuàizi · sháozi · bēizi · chāzi · dāozi","vi":"Nhóm 2 – Dụng cụ ăn uống: đũa, muỗng, cốc, nĩa, dao"},"source":"manual"},{"id":"洗手台_xi3shou3tai2","hanzi":"洗手台","pinyin":"xǐshǒutái","hanViet":"tẩy thủ đài","vi":"bồn rửa tay","topic":"home","freqRank":696,"phrase":true,"chars":[{"c":"洗","radical":"水","radicalVi":"thủy","strokes":9,"parts":"⿰氵先"},{"c":"手","radical":"手","radicalVi":"thủ","strokes":4},{"c":"台","radical":"口","radicalVi":"khẩu","strokes":5,"parts":"⿱厶口"}],"structure":"<b>洗</b> (rửa) + <b>手</b> (tay) + <b>台(臺)</b> (bệ, bục) → bệ để rửa tay.","example":{"zh":"洗手台在卫生间里。","py":"Xǐshǒutái zài wèishēngjiān li.","vi":"Bồn rửa tay ở trong nhà vệ sinh."},"source":"manual","aiFields":["example"]},{"id":"饮水机_yin3shui3ji1","hanzi":"饮水机","pinyin":"yǐnshuǐjī","hanViet":"ẩm thủy cơ","vi":"máy nước uống","topic":"home","freqRank":698,"phrase":true,"chars":[{"c":"饮","radical":"食","radicalVi":"thực","strokes":7,"parts":"⿰饣欠"},{"c":"水","radical":"水","radicalVi":"thủy","strokes":4},{"c":"机","radical":"木","radicalVi":"mộc","strokes":6,"parts":"⿰木几"}],"structure":"<b>饮(飲)</b> (<b>饣</b> ăn uống + <b>欠</b> há miệng → uống) + <b>水</b> (nước) + <b>机</b> (máy) → máy nước uống.","example":{"zh":"渴 · 接水 · 饮水机 · 烫","py":"kě · jiēshuǐ · yǐnshuǐjī · tàng","vi":"Nhóm 3 – Uống nước: khát, hứng nước, máy nước uống, nóng bỏng"},"source":"manual"}]
