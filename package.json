{
  "name": "chinese-app",
  "private": true,
  "type": "module",
  "scripts": {
    "data:fetch": "node --env-file-if-exists=.env scripts/fetch-sources.ts",
    "data:legacy": "node --env-file-if-exists=.env scripts/extract-legacy.ts",
    "data:candidates": "node --env-file-if-exists=.env scripts/build-candidates.ts",
    "data:classify": "node --env-file-if-exists=.env scripts/llm-classify.ts",
    "data:select": "node --env-file-if-exists=.env scripts/select-words.ts",
    "data:enrich": "node --env-file-if-exists=.env scripts/llm-enrich.ts",
    "data:verify": "node --env-file-if-exists=.env scripts/llm-verify.ts",
    "data:words": "node --env-file-if-exists=.env scripts/build-words.ts",
    "data:all": "npm run data:legacy && npm run data:candidates && npm run data:classify && npm run data:select && npm run data:enrich && npm run data:verify && npm run data:words",
    "data:apply": "node scripts/apply-answers.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "fflate": "^0.8.3",
    "pinyin-pro": "^3.29.5",
    "zod": "^4.6.7"
  }
}
